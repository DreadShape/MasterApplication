<Window x:Class="MasterApplication.UserControls.ScreenShot.ScreenShotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="ScreenShotWindow"
        d:DesignHeight="450"
        d:DesignWidth="800"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowState="Maximized"
        WindowStyle="None"
        mc:Ignorable="d">

  <materialDesign:DialogHost DialogContentUniformCornerRadius="5"
                             DialogTheme="Inherit"
                             Identifier="ScreenShotDialog">
    <Grid>
      <!-- Screenshot Image -->
      <Image x:Name="ScreenshotImage"
             RenderOptions.BitmapScalingMode="HighQuality"
             Stretch="Fill" />

      <!-- Semi-transparent overlay -->
      <Canvas x:Name="OverlayCanvas">

        <!-- 4 Dark overlay rectangles -->
        <Rectangle x:Name="OverlayTop" Fill="#80000000" />
        <Rectangle x:Name="OverlayLeft" Fill="#80000000" />
        <Rectangle x:Name="OverlayRight" Fill="#80000000" />
        <Rectangle x:Name="OverlayBottom" Fill="#80000000" />

        <!-- The white selection rectangle -->
        <Rectangle x:Name="SelectionRectangle"
               Fill="Transparent"
               Stroke="White"
               StrokeThickness="1"
               Visibility="Collapsed" />
      </Canvas>

    </Grid>
  </materialDesign:DialogHost>

</Window>
