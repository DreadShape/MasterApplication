<UserControl x:Class="MasterApplication.Feature.MouseClicker.MouseClickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Enums="clr-namespace:MasterApplication.Models.Enums"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:MasterApplication.Feature.MouseClicker"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DataContext="{d:DesignInstance Type=local:MouseClickerViewModel,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
  <materialDesign:DialogHost DialogContentUniformCornerRadius="5"
                             DialogTheme="Inherit"
                             Identifier="AutoClickerMenuDialog">
    <Grid>
      <materialDesign:Card Padding="5" Background="{StaticResource PrimaryMidBackgroundColor}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>
            <ColumnDefinition />
          </Grid.ColumnDefinitions>

          <!-- MenuGrid -->
          <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- SequenceComboBox -->
            <ComboBox Grid.Column="0"
                      materialDesign:HintAssist.Hint="Sequence"
                      DisplayMemberPath="Name"
                      IsEnabled="{Binding IsSequenceComboBoxEnabled}"
                      ItemsSource="{Binding AutoClickerSequences}"
                      SelectedItem="{Binding CurrentSequence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Style="{StaticResource BiggerFontComboBox}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                  <i:InvokeCommandAction Command="{Binding SequenceSelectedItemChangedCommand}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </ComboBox>

            <!-- AddSequenceButton -->
            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding AddSequenceCommand}"
                    Content="Add Sequence"
                    Style="{StaticResource BiggerLightButtons}" />

            <!-- DeleteSequenceButton -->
            <Button Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding DeleteSequenceCommand}"
                    Content="Delete Sequence"
                    Style="{StaticResource BiggerSecondaryLightButtons}" />

            <!-- OpenAutoClickerMenuButton -->
            <Button Grid.Column="3"
                    Margin="10,0,0,0"
                    Command="{Binding OpenAutoClickerMenuCommand}"
                    Content="Open Auto Clicker"
                    Style="{StaticResource BiggerLightButtons}" />
          </Grid>

          <!-- TemplateSettings -->
          <materialDesign:Card Grid.Row="1"
                               Grid.Column="0"
                               Height="Auto"
                               Margin="0,10,0,0"
                               Padding="5"
                               Background="{StaticResource PrimaryDarkBackgroundColor}"
                               Visibility="{Binding IsSequenceDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>

              <!-- TemplateSearchingRegionGrid -->
              <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                </Grid.RowDefinitions>

                <!-- TemplateImageTextBox -->
                <TextBlock Grid.Row="0"
                           Grid.ColumnSpan="3"
                           Margin="0,10,0,10"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Text="SEARCHING REGION IMAGE" />

                <!-- SearchingRegionImage -->
                <Image Grid.Row="1"
                       Margin="10,0,5,0"
                       Source="{Binding CurrentShowingTemplateSearchingRegionImage, Converter={StaticResource ByteArrayToBitmapImageConverter}}"
                       Stretch="Uniform" />
              </Grid>

              <!-- TemplateImagesGrid -->
              <Grid Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="5,0,10,0"
                    Visibility="{Binding NumberOfTemplateImages, Converter={StaticResource IntToVisibilityConverter}}">

                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- TemplateImageTextBox -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="0,10,0,10"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Text="TEMPLATE IMAGE" />

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="3">

                  <!-- TemplateImage -->
                  <Image x:Name="TemplateImage"
                         Source="{Binding CurrentShowingImage, Converter={StaticResource ByteArrayToBitmapImageConverter}}"
                         Stretch="Uniform" />

                  <!-- CrossOverlay -->
                  <Canvas x:Name="OverlayCanvas"
                          Width="{Binding ActualWidth, ElementName=TemplateImage}"
                          Height="{Binding ActualHeight, ElementName=TemplateImage}"
                          IsHitTestVisible="False">
                    <Line x:Name="CrossLine1"
                          Stroke="Red"
                          StrokeThickness="4"
                          Visibility="Collapsed" />
                    <Line x:Name="CrossLine2"
                          Stroke="Red"
                          StrokeThickness="4"
                          Visibility="Collapsed" />
                  </Canvas>
                </Grid>

                <!-- Pagination -->
                <!-- PreviousTemplateImageButton -->
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Width="40"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Right"
                        Command="{Binding PreviousTemplateImageCommand}">
                  <materialDesign:PackIcon Width="24"
                                           Height="24"
                                           HorizontalAlignment="Center"
                                           Kind="ChevronLeft" />
                </Button>

                <!-- PageNumber -->
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="20,0,20,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                  <Run Text="{Binding CurrentTemplateImageIndex, Converter={StaticResource AddOneToIndexConverter}}" />

                  <!-- Static text -->
                  <Run Text="/" />

                  <Run Text="{Binding NumberOfTemplateImages}" />
                </TextBlock>

                <!-- NextTemplateImageButton -->
                <Button Grid.Row="2"
                        Grid.Column="2"
                        Width="40"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Left"
                        Command="{Binding NextTemplateImageCommand}">
                  <materialDesign:PackIcon Width="24"
                                           Height="24"
                                           HorizontalAlignment="Center"
                                           Kind="ChevronRight" />
                </Button>
              </Grid>

              <!-- TemplateButtons -->
              <Grid Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Column1 -->
                <!-- ChangeTemplateButton -->
                <Button Grid.Row="0"
                        Grid.Column="0"
                        Margin="5,0,5,10"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeTemplateImageCommand}"
                        Content="Change Current Template"
                        Style="{StaticResource BiggerLightButtons}" />

                <!-- AddTemplateButton -->
                <Button Grid.Row="1"
                        Grid.Column="0"
                        Margin="5,0,5,10"
                        VerticalAlignment="Center"
                        Command="{Binding AddTemplateImageCommand}"
                        Content="Add New Template"
                        Style="{StaticResource BiggerLightButtons}" />

                <!-- DeleteTemplateButton -->
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Margin="5,0,5,5"
                        Command="{Binding DeleteTemplateImageCommand}"
                        Content="Delete Current Template"
                        Style="{StaticResource BiggerSecondaryLightButtons}" />

                <!-- Column2 -->
                <!-- ChangeClickCoordinatesTemplateButton -->
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Margin="5,0,5,10"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeClickCoordinateTemplateImageCommand}"
                        Content="Change Click Coordinates"
                        Style="{StaticResource BiggerLightButtons}" />

                <Grid Grid.Row="1" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>

                  <!-- DelayBeforeClickingTextBox -->
                  <TextBox Grid.Column="0"
                           Margin="5,0,5,10"
                           VerticalAlignment="Center"
                           materialDesign:HintAssist.Hint="Delay Before Clicking (ms)"
                           materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 10 0"
                           AcceptsReturn="False"
                           GotFocus="TextBox_GotFocus"
                           IsEnabled="{Binding IsDelayBeforeAndAfterClickingTextBoxEnabled}"
                           PreviewKeyDown="TextBox_PreviewKeyDown"
                           PreviewTextInput="TextBox_PreviewTextInput"
                           Style="{StaticResource BiggerFontOutlineTextBox}"
                           Text="{Binding DelayBeforeClicking, UpdateSourceTrigger=PropertyChanged}" />

                  <!-- DelayAfterClickingTextBox -->
                  <TextBox Grid.Column="1"
                           Margin="5,0,5,10"
                           VerticalAlignment="Center"
                           materialDesign:HintAssist.Hint="Delay After Clicking (ms)"
                           materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 10 0"
                           AcceptsReturn="False"
                           GotFocus="TextBox_GotFocus"
                           IsEnabled="{Binding IsDelayBeforeAndAfterClickingTextBoxEnabled}"
                           PreviewKeyDown="TextBox_PreviewKeyDown"
                           PreviewTextInput="TextBox_PreviewTextInput"
                           Style="{StaticResource BiggerFontOutlineTextBox}"
                           Text="{Binding DelayAfterClicking, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- SetStartAndStopKeybindingGrid -->
                <Grid Grid.Row="2" Grid.Column="1">

                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>

                  <!-- StartKeybind -->
                  <Button Grid.Column="0"
                          Margin="5,0,5,5"
                          Command="{Binding SetKeybindCommand}"
                          CommandParameter="Start"
                          Style="{StaticResource BiggerLightButtons}">
                    <TextBlock>
                      <Run Text="Start Keybind: " />
                      <Run Text="{Binding StartKeybindName}" />
                    </TextBlock>
                  </Button>

                  <!-- StopKeybind -->
                  <Button Grid.Column="1"
                          Margin="5,0,5,5"
                          Command="{Binding SetKeybindCommand}"
                          CommandParameter="Stop"
                          Style="{StaticResource BiggerLightButtons}">
                    <TextBlock>
                      <Run Text="Stop Keybind: " />
                      <Run Text="{Binding StopKeybindName}" />
                    </TextBlock>
                  </Button>
                </Grid>

                <!-- Column3 -->
                <Grid Grid.Row="0" Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>

                  <!-- MatchThresholdTextBox -->
                  <TextBox Grid.Column="0"
                           Margin="5,0,5,10"
                           VerticalAlignment="Center"
                           materialDesign:HintAssist.Hint="Threshold"
                           materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 10 0"
                           AcceptsReturn="False"
                           GotFocus="TextBox_GotFocus"
                           IsEnabled="{Binding IsDelayBeforeAndAfterClickingTextBoxEnabled}"
                           PreviewKeyDown="TextBox_PreviewKeyDown"
                           PreviewTextInput="TextBox_PreviewTextInput"
                           Style="{StaticResource BiggerFontOutlineTextBox}"
                           Text="{Binding MatchThreshold, UpdateSourceTrigger=PropertyChanged}" />

                  <!-- ShowClickCoordinatesStackPanel -->
                  <StackPanel Grid.Column="1"
                              Margin="5,0,5,10"
                              MouseDown="StackPanel_MouseDown"
                              Orientation="Vertical"
                              Visibility="{Binding IsShowCoordinatesToggleButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Margin="10,0,10,5"
                               HorizontalAlignment="Center"
                               Cursor="Hand"
                               Text="Show Click Coordinates" />

                    <Viewbox Height="30" Stretch="Uniform">
                      <ToggleButton x:Name="ShowCoordinatesToggleButton"
                                    Click="ShowCoordinatesToggleButton_Click"
                                    CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </Viewbox>
                  </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>

                  <!-- MonitorForChangeCheckBox -->
                  <CheckBox Grid.Row="1"
                            Grid.Column="0"
                            Margin="5,0,0,10"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MonitorForChange}"
                            IsEnabled="{Binding IsDelayBeforeAndAfterClickingTextBoxEnabled}"
                            Style="{StaticResource BiggerFontCheckBox}">
                    <TextBlock Margin="0,0,0,0"
                               FontSize="13"
                               Text="Monitor for Change" />
                  </CheckBox>

                  <!-- MonitorForChangeIntervalTextBox -->
                  <TextBox Grid.Column="1"
                           Margin="5,0,5,10"
                           VerticalAlignment="Center"
                           materialDesign:HintAssist.Hint="Change Interval (ms)"
                           materialDesign:TextFieldAssist.TextBoxViewMargin="1 0 10 0"
                           AcceptsReturn="False"
                           GotFocus="TextBox_GotFocus"
                           IsEnabled="{Binding IsDelayBeforeAndAfterClickingTextBoxEnabled}"
                           PreviewKeyDown="TextBox_PreviewKeyDown"
                           PreviewTextInput="TextBox_PreviewTextInput"
                           Style="{StaticResource BiggerFontOutlineTextBox}"
                           Text="{Binding MonitorForChangeInterval, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Row="2" Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>

                  <!-- ChangeClickCoordinatesTemplateButton -->
                  <Button Grid.Column="0"
                          Margin="5,0,5,5"
                          VerticalAlignment="Center"
                          Command="{Binding SetSearchingRegionCommand}"
                          Content="Set Searching Region"
                          Style="{StaticResource BiggerLightButtons}" />

                  <!-- SaveSequenceToFileButton -->
                  <Button Grid.Column="1"
                          Margin="5,0,5,5"
                          Command="{Binding SaveSequenceToFileCommand}"
                          Content="Save Sequence to File"
                          Style="{StaticResource BiggerSecondaryLightButtons}" />
                </Grid>


              </Grid>
            </Grid>
          </materialDesign:Card>
        </Grid>
      </materialDesign:Card>

      <!-- SnackBar -->
      <materialDesign:Snackbar MessageQueue="{Binding SnackbarMessageQueue}" />

    </Grid>
  </materialDesign:DialogHost>
</UserControl>
